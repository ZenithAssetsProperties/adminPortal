# Database (Supabase Postgres connection string, or any Postgres)
DATABASE_URL=postgres://zenith:zenith@localhost:54329/zenith

# Long random string (32+ chars) used to sign staff and customer sessions
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First super admin, created by `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-12345

# Public main website origins allowed to call /api/v1 (comma separated)
ALLOWED_ORIGINS=http://localhost:3001,https://zenithassetsproperties.netlify.app

# Paystack
PAYSTACK_SECRET_KEY=

# File storage (Cloudflare R2 / any S3). Leave empty in dev to store on local disk.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Notifications (leave empty in dev: messages are printed to the console)
RESEND_API_KEY=
EMAIL_FROM=Zenith Asset Group <no-reply@example.com>
TERMII_API_KEY=
TERMII_SENDER_ID=Zenith

# Shared key the main website server uses for server-to-server calls (analytics etc.)
PUBLIC_API_KEY=

# Secret that scheduled jobs (reservation expiry, payment reminders) send as `Authorization: Bearer <value>`
CRON_SECRET=

# How many proxies sit in front of this app (used to read the real client IP safely). Netlify/Vercel: leave 1.
TRUSTED_PROXY_HOPS=1
# Header your host sets with the true client IP (it must overwrite any client-sent value).
# Netlify: x-nf-client-connection-ip   Vercel: x-vercel-forwarded-for   Leave empty if unsure.
CLIENT_IP_HEADER=

# Main website origin and where Paystack sends customers after paying
FRONTEND_URL=https://zenithassetsproperties.netlify.app
PAYMENT_CALLBACK_URL=https://zenithassetsproperties.netlify.app/payment/return

